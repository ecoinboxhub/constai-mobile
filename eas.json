{
  "cli": {
    "version": ">= 9.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "VITE_API_URL": "http://10.0.2.2:8000/api/v1"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "VITE_API_URL": "https://staging.constai-nigeria.com/api/v1"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "VITE_API_URL": "https://api.constai-nigeria.com/api/v1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
